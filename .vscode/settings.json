{
    "sqltools.connections": [
        {
            "previewLimit": 50,
            "driver": "SQLite",
            "name": "SQLite-study",
            "database": "~/SQLStudy/db/study.db"
        }
    ],

    "files.associations": {
        "*.yml": "yaml",
        "*.yaml": "yaml"
    },

    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },

    "editor.renderWhitespace": "all",
    "editor.showFoldingControls": "always",
    "editor.showIndentGuides": true
}